{
	"name": "@ondewo/nlu-client-typescript",
	"version": "7.2.0",
	"description": "ONDEWO Natural Language Understanding (NLU) Client library for Typescript",
	"author": "ONDEWO GmbH <office@ondewo.com>",
	"homepage": "https://ondewo.com",
	"license": "Apache-2.0",
	"keywords": [
		"ondewo",
		"nlu",
		"api",
		"client",
		"typescript",
		"grpc"
	],
	"main": "public-api.js",
	"typings": "public-api.d.ts",
	"scripts": {
		"start": "npm run build",
		"build": "docker run -v ${PWD}:/input-volume -v ${PWD}/..:/output-volume ondewo-typescript-proto-compiler ondewo-nlu-api ondewo",
		"predebug": "# mv ondewo-nlu-api/google ondewo-nlu-api/google",
		"debug": "docker run --entrypoint /bin/bash -v ${PWD}:/input-volume -v ${PWD}/..:/output-volume ondewo-typescript-proto-compiler",
		"pretest": "rm -rf .test-build && tsc -p tsconfig.test.json && ln -sfn ../api .test-build/api && npm run build:test:protos",
		"test": "c8 node --test .test-build/*/*.spec.js && npm run test:protos",
		"build:test:protos": "tsc tests/bundleStringRoundTrip.spec.ts --ignoreConfig --module commonjs --target es2020 --strict --lib es2020,dom --skipLibCheck --sourceMap --types node --typeRoots ./node_modules/@types --outDir .test-build",
		"test:protos": "node --test .test-build/bundleStringRoundTrip.spec.js"
	},
	"repository": {
		"type": "git",
		"directory": "https://github.com/ondewo/ondewo-nlu-client-typescript"
	},
	"dependencies": {
		"google-protobuf": "4.0.2",
		"grpc-web": "^1.5.0",
		"tslib": "^2.8.1",
		"undici": "^6.27.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.15.27",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"c8": "^11.0.0",
		"dotenv": "^16.4.5",
		"eslint": "^9.39.5",
		"global": "^4.4.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3"
	}
}
